# Development only. Production values must come from Azure Key Vault.
NODE_ENV=development
PORT=3100
APP_BASE_PATH=/campusfix
DATABASE_URL=mysql://campusfix_user:password@127.0.0.1:3306/campusfix
JWT_SECRET=replace-with-a-long-random-development-secret
ENTRA_TENANT_ID=replace-with-directory-tenant-id
ENTRA_CLIENT_ID=replace-with-campusfix-api-client-id
CORS_ORIGINS=http://localhost:5173
ADMIN_EMAILS=you@university.edu
DEV_AUTH_BYPASS=false

